datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GrievanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model GrievanceTicket {
  id          String          @id // Unique generated tracking ID (e.g. GRV-YYYYMMDD-XXXX)
  name        String
  email       String
  phone       String

  state       String?
  district    String?
  cityTown    String?
  mandal      String?
  villageWard String?
  address     String?
  pincode     String?

  category    String
  subject     String
  description String
  status      GrievanceStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  logs        GrievanceLog[]

  @@index([id])
}

model GrievanceLog {
  id        String          @id @default(uuid())
  ticketId  String
  ticket    GrievanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status    GrievanceStatus
  notes     String
  createdAt DateTime        @default(now())

  @@index([ticketId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String   // "VISIT" or "PWA_INSTALL"
  pathname  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

